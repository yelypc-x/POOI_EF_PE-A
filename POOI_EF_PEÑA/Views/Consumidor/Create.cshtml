@model POOI_EF_PEÑA.Models.Consumidor

@{
    ViewBag.Title = "Nuevo consumidor";
}

<h2>Registrar Consumidor</h2>

@using (Html.BeginForm("Create", "Consumidor", FormMethod.Post))
{
    <div class="form-group">
        @Html.LabelFor(m => m.dnicont)
        @Html.TextBoxFor(m => m.dnicont, new { @class = "form-control", maxlength = 8 })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.nomcont)
        @Html.TextBoxFor(m => m.nomcont, new { @class = "form-control", maxlength = 40 })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.apecont)
        @Html.TextBoxFor(m => m.apecont, new { @class = "form-control", maxlength = 40 })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.emailcont)
        @Html.TextBoxFor(m => m.emailcont, new { @class = "form-control", maxlength = 250 })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.idpais)
        @Html.TextBoxFor(m => m.idpais, new { @class = "form-control", maxlength = 3 })
    </div>

    <input type="submit" value="Registrar" class="btn btn-success" />
    @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-default" })
}

@if (ViewBag.mensaje != null)
{
    <div class="alert alert-info" style="margin-top:15px">@ViewBag.mensaje</div>
}